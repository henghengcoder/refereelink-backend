{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/refereelink-team/refereelink-backend/contracts/frame-state.schema.json",
  "title": "RefereeLink FrameState WebSocket payload",
  "type": "object",
  "required": [
    "type",
    "frame_id",
    "capture_timestamp_ms",
    "processed_timestamp_ms",
    "processing_fps",
    "homography_status",
    "players",
    "events"
  ],
  "not": {
    "anyOf": [
      { "required": ["ball"] },
      { "required": ["possession_track_id"] }
    ]
  },
  "properties": {
    "type": { "const": "frame_state" },
    "frame_id": { "type": "integer" },
    "capture_timestamp_ms": { "type": "number" },
    "processed_timestamp_ms": { "type": "number" },
    "processing_fps": { "type": "number" },
    "homography_status": {
      "type": "string",
      "enum": ["fresh", "reused", "stale", "unavailable"]
    },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/player" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "capture_source": {
      "anyOf": [
        { "$ref": "#/$defs/capture_source" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "player": {
      "type": "object",
      "required": ["track_id", "role", "team", "team_label", "team_id", "confidence"],
      "properties": {
        "track_id": { "type": "integer" },
        "role": { "type": "string" },
        "team": { "type": "string", "enum": ["home", "away", "none", "unknown"] },
        "team_label": { "type": "string", "enum": ["home", "away", "none", "unknown"] },
        "team_id": { "type": "integer" },
        "confidence": { "type": "number" },
        "field_x": { "type": ["number", "null"] },
        "field_y": { "type": ["number", "null"] }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "event_type", "confidence", "severity", "timestamp", "frame_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number" },
        "severity": { "type": "string" },
        "timestamp": { "type": "number" },
        "frame_id": { "type": "integer" }
      }
    },
    "capture_source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "session_id": { "type": ["string", "null"] },
        "stream_epoch": { "type": ["integer", "null"] },
        "source_frame_id": { "type": ["integer", "null"] },
        "t_us": { "type": ["integer", "null"] },
        "transport_pts90k": { "type": ["integer", "null"] },
        "camera_motion": { "type": ["object", "null"] },
        "pose_missing_reason": { "type": ["string", "null"] },
        "backend_received_at_ms": { "type": ["number", "null"] }
      }
    }
  }
}
